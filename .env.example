# --- core ---
DB_PATH=duo_monitor.db
BASE_URL=https://your-domain.example      # used for Stripe success/cancel URLs
POLL_SECONDS=30
FAMILIES=iphone-duo
MAX_STORES=2
WATCH_DAYS=14
PRICE_CENTS=499
# optional, comma-separated http://user:pass@host:port; rotated per request
PROXIES=

# --- payments (empty = free mode: subscriptions start immediately) ---
BASIC_AUTH=                   # "user:pass" — password-protect the whole site before launch
ACCESS_KEY=                   # share link /?key=… sets a cookie — password-free access before launch
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- channels (a channel is offered only when its keys are set; none set = console mode) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                  # verified toll-free or 10DLC number, E.164
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. alerts@your-domain.example (verified in Resend)
SMS_OUTBOX=                   # interim: JSONL outbox drained by an external sender (testing only)
SMTP_HOST=                    # interim email if Resend is not set up (SSL :465)
SMTP_USER=
SMTP_PASSWORD=
